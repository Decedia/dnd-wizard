# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env
.env

# transient run state for the enhancement scripts
src/locales/parts/id/.enhance-progress.lock
src/locales/parts/en/.enhance-progress.lock
src/locales/parts/id/.enhance-classes-races-progress.json
src/locales/parts/id/.enhance-classes-races-progress.lock
src/locales/parts/en/.enhance-classes-races-progress.json
src/locales/parts/en/.enhance-classes-races-progress.lock
